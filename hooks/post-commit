#!/usr/bin/env bash
# Sync committed scripts into ~/bin so PATH copies never drift from HEAD.
set -euo pipefail

REPO_ROOT=$(git rev-parse --show-toplevel)
BINDIR="$HOME/bin"

for cmd in savenit fixnit checknit; do
    [[ -f "$REPO_ROOT/$cmd" ]] || continue
    # Skip if already in sync; bin copy may be hand-installed elsewhere
    if ! cmp -s "$BINDIR/$cmd" "$REPO_ROOT/$cmd" 2>/dev/null; then
        install -m 755 "$REPO_ROOT/$cmd" "$BINDIR/$cmd"
        echo "post-commit: synced $cmd -> $BINDIR/$cmd"
    fi
done
