#!/usr/bin/env bash
set -euo pipefail

# Zero-friction by design: args are the complaint, the clipboard is grabbed
# automatically, and nothing ever prompts when args are present. -n skips the
# clipboard grab for the rare stale-clipboard case. Bare interactive runs get
# a complaint prompt only, since unquoted metacharacters (', `, <, >, \) never
# survive the shell long enough to become args anyway.
NOCLIP=0
if [[ "${1:-}" == "-n" || "${1:-}" == "--no-clip" ]]; then
    NOCLIP=1
    shift
fi

if [[ $# -gt 0 ]]; then
    COMPLAINT="$*"
elif [[ -t 0 ]]; then
    printf 'What is annoying you? '
    read -r -e COMPLAINT
    if [[ -z "$COMPLAINT" ]]; then
        echo "Usage: savenit [-n]   (type your complaint at the prompt; -n skips clipboard)" >&2
        exit 1
    fi
else
    echo "Usage: savenit [-n]   (type your complaint at the prompt; -n skips clipboard)" >&2
    exit 1
fi

DATE=$(date '+%Y-%m-%d')
TIME=$(date '+%H:%M')
# Seconds in the filename timestamp: two nits saved in the same minute would
# collide on OUTFILE and silently overwrite. Lexical sort still equals date sort.
TIMESTAMP="${DATE}-$(date '+%H-%M-%S')"
HOST=$(hostname)
OS_TYPE=$(sw_vers -productVersion 2>/dev/null || uname -rs)
CAPTURED=""
if [[ $NOCLIP -eq 0 ]]; then
    CAPTURED=$(pbpaste 2>/dev/null || true)
fi

# Same-second saves (scripted loops, rapid humans) still collide. Suffix the
# name until unique, and track the final stamp so the template's rename steps
# always match the file that actually landed on disk.
NIT_STAMP="$TIMESTAMP"
N=1
OUTFILE_CANDIDATE="$HOME/claude-busywork/new-nit-${NIT_STAMP}.md"
while [[ -e "$OUTFILE_CANDIDATE" ]]; do
    N=$((N+1))
    NIT_STAMP="${TIMESTAMP}-${N}"
    OUTFILE_CANDIDATE="$HOME/claude-busywork/new-nit-${NIT_STAMP}.md"
done
OUTFILE="$OUTFILE_CANDIDATE"

# Build AGENT_INSTRUCTIONS safely -- no heredoc expansion risk
if [[ -n "$CAPTURED" ]]; then
    AGENT_INSTRUCTIONS="${COMPLAINT}

Captured output for context:
${CAPTURED}"
else
    AGENT_INSTRUCTIONS="${COMPLAINT}"
fi

# Write the nit file using quoted heredocs (no variable expansion) for static
# sections, and printf '%s\n' for user-supplied content. This handles any
# special characters in the complaint: quotes, backticks, backslashes, angle
# brackets, dollar signs, etc.
{
    cat << 'HDR'
# NitFile - for fixing the pesky things while bored

# Human complaint:

HDR
    printf '%s\n' "$COMPLAINT"
    printf '\n'
    printf '## Issue status: NEW\n'
    printf '\n'
    printf '## When it happened: %s at %s on %s (%s)\n' "$DATE" "$TIME" "$HOST" "$OS_TYPE"
    printf '\n'
    printf '## Where it happened (invoked from): %s\n' "$PWD"
    printf '\n'
    cat << 'SECTION2'
## When was it fixed:

# Human prompt for the AI agent on what action to take:

SECTION2
    printf '%s\n' "$AGENT_INSTRUCTIONS"
    printf '\n'
    cat << 'FOOTER'
# AI agent question back to the human

Maximum two questions, pick the most important 1 or 2 questions needed to unblock.  Small issues, I leave it to the AI to decide what is best.

(In bullets, no more than 2 bullets, no more than 5-20 words per bullet)

# AI resolution summary

(In bullets, no more than 5 bullets, no more than 5-20 words per bullet)

# List of files to be edited and their backups, and sizes

filename.sh - 2600 bytes
filename-autoAgenticNitFix.sh - 2600 bytes

# List of files that were edited and their new sizes, and their backups and their sizes, and the changelog of what was changed

filename.sh - 3821 bytes
filename-autoAgenticNitFix-backup.sh - 2600 bytes
filename-autoAgenticNitFix-changelog.md


# Steps for the AI agent to take after addressing the prompt

## Change issue status
status states allowed are:
NEW -> REVIEW -> INPROGRESS -> PENDINGHUMAN -> DONE
                            -> QA -> DONE

if the AI can self validate the issue is resolved via some minimal QA, it can move to DONE

# Make a plan and resolve the issue

## Lock every file you intend to edit BEFORE touching it

For each file: run mkdir <filename>.lock
If mkdir fails, another agent owns that file. Do NOT edit it. Record the conflict in this nit, set status PENDINGHUMAN, and stop.
After ALL edits are complete and validated: rmdir each lock you created.
Never remove a lock you did not create. Never edit a file whose .lock exists.

## If human questions are needed, AI agent is to ask advisor if available to see if it can make an informed decision on how to proceed, assuming it is safe

## Any changes to existing shell scripts, or configuration files, are to be backed up first

backup name:

filename.sh
copied to filename-autoAgenticNitFix-Backup.sh

## Validate the backup exists and matches file size

## Document the list of files to be edited and their backup in this file

## Create a filename-autoAgenticNitFix-proposed-changelog.md which has no more than 5 bullets of 5-20 words each about what is to be changed and why.  First bullet says "History and current status: <absolute path to nitfile>".  Second bullet says "Resolved by: log=<absolute path to done-nit-<nit timestamp>-agent.log> finished=<datetime>".  Do not self-report your model or mode; the launcher stamps those into the nitfile.  The agent log is the durable record of who worked this nit.

## Implement the changes

## After implementing the change, spawn a sonnet subagent to test the change or validate the fix to the best of the ability
update the nitFile with the # AI resolution summary

## After implementing the change, spawn a sonnet subagent to update the proposed_changelog.md as needed if something changed in the plan, and update the nitFile with the # AI resolution summary

## After the issue is fully resolved and tested

spawn a subagent to:
FOOTER
    printf '1/ Rename filename-autoAgenticNitFix-proposed-changelog.md to filename-autoAgenticNitFix-changelog.md\n'
    printf '2/ Update the NitFile status field issueStatus to DONE\n'
    printf '3/ Update the Nitfile status field whenFixed to %s at %s by <model>\n' "$DATE" "$TIME"
    printf '4/ Rename the Nitfile from new-nit-%s.md to done-nit-%s.md\n' "$NIT_STAMP" "$NIT_STAMP"
    printf '5/ Rename the agent log $HOME/claude-busywork/inprogress-nit-%s-agent.log to $HOME/claude-busywork/done-nit-%s-agent.log (if it exists)\n' "$NIT_STAMP" "$NIT_STAMP"
} > "$OUTFILE"

LINE_COUNT=$(printf '%s\n' "$CAPTURED" | wc -l | tr -d ' ')
if [[ -n "$CAPTURED" ]]; then
    echo "Validated pbcopy got your clipboard: ${LINE_COUNT} lines"
fi
